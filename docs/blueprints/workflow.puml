@startuml EC2U PhD Agreements Tool Flow
!theme plain

participant "Client" as client
participant "Resolver" as resolver
participant "KVS" as kvs
participant "Queue Consumer" as consumer
participant "Gemini" as gemini

== Read (Cache Hit) ==

client -> resolver: get resource
activate resolver
resolver -> kvs: read resource key
kvs --> resolver: value (fresh)
resolver --> client: 200 value
deactivate resolver

== Read (Cache Miss) ==

client -> resolver: get resource
activate resolver
resolver -> kvs: read resource key
kvs --> resolver: empty / stale
resolver -> kvs: write Activity.Scheduling
resolver -> consumer: queue async task
resolver --> client: 202 Activity.Scheduling
deactivate resolver

par

    group async task
        consumer -> kvs: acquire lock
        activate consumer

        consumer -> kvs: write Activity.Fetching
        consumer -> gemini: execute prompt
        activate gemini
        gemini --> consumer: response
        deactivate gemini

        consumer -> kvs: write Activity.Extracting
        consumer -> gemini: execute prompt
        activate gemini
        gemini --> consumer: response
        deactivate gemini

        consumer -> kvs: write result
        consumer -> kvs: release lock
        deactivate consumer
    end

else

    group polling
        client -> resolver: get resource
        activate resolver
        resolver -> kvs: read resource key
        kvs --> resolver: Activity
        resolver --> client: 202 Activity
        deactivate resolver
    end

end

client -> resolver: get resource
activate resolver
resolver -> kvs: read resource key
kvs --> resolver: value
resolver --> client: 200 value
deactivate resolver

== Error ==

client -> resolver: get resource
activate resolver
resolver -> kvs: read resource key
kvs --> resolver: Trace
resolver --> client: error
deactivate resolver

@enduml
