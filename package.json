{
  "private": true,
  "name": "@ec2u/phds",
  "description": "EC2U PhD Agreements Tool Confluence plugin",
  "homepage": "https://github.com/ec2u/phds",
  "repository": "github:ec2u/phds",
  "bugs": {
    "url": "https://github.com/ec2u/phds/issues",
    "email": "cc@ml.ec2u.eu"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "EC2U Connect Centre",
    "email": "cc@ml.ec2u.eu",
    "url": "https://www.ec2u.eu/"
  },
  "type": "commonjs",
  "main": "index",
  "scripts": {
    "clean": "rm -rf .forge node_modules",
    "setup": "npm install --legacy-peer-deps && npm audit fix; npm rebuild",
    "check": "npx vitest --typecheck run",
    "build": "npx honkit build docs/reference",
    "serve": "npx dotenv -- forge tunnel",
    "proof": "npx honkit serve --port 4100 --open docs/reference",
    "issue": "forge install --non-interactive --upgrade -s https://ec2u.atlassian.net/ -p confluence -e production"
  },
  "dependencies": {
    "@forge/bridge": "^5.9.1",
    "@forge/events": "^1.0.3",
    "@forge/kvs": "^1.0.4",
    "@forge/react": "^11.2.5",
    "@forge/realtime": "^0.3.2",
    "@forge/resolver": "^1.6.10",
    "@google/genai": "1.30.0",
    "bignumber.js": "^9.3.1",
    "react": "^18.2.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.18",
    "@types/react": "^19.1.4",
    "dotenv-cli": "^8.0.0",
    "gitbook-plugin-flexible-alerts": "^1.0.4",
    "gitbook-plugin-insert-logo": "^0.1.5",
    "gitbook-plugin-intopic-toc": "^1.1.1",
    "gitbook-plugin-page-footer-ex": "^0.1.2",
    "gitbook-plugin-toolbar": "^0.6.0",
    "honkit": "^6.1.6",
    "supports-color": "^10.2.2",
    "typescript": "^5.8.3",
    "vitest": "^4.0.18"
  }
}
